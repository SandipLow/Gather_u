{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },
    "dev:host": {
      "cache": false,
      "persistent": true
    },
    "dev:s2": {
      "cache": false,
      "persistent": true
    },
    "dev:s3": {
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "build/**"]
    },
    "start": {
      "cache": false,
      "persistent": true
    },
    "check": {
      "cache": true
    }
  }
}
